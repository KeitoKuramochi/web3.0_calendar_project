---
import '../styles/global.css';
import AuthGuard from '../components/AuthGuard';
import TeacherDashboard from '../components/TeacherDashboard';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>先生ダッシュボード — 研究室ボット</title>
  </head>
  <body class="bg-gray-50 min-h-screen">

    <!-- ヘッダー -->
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
      <h1 class="text-xl font-bold text-gray-900">先生ダッシュボード</h1>
      <div class="flex items-center gap-4">
        <AuthGuard client:load />
        <a
          href="/chat"
          class="bg-blue-600 text-white font-semibold px-5 py-2 rounded-lg shadow hover:bg-blue-700 transition-colors text-sm"
        >
          AIに話しかける
        </a>
      </div>
    </header>

    <TeacherDashboard client:load />

    <!-- チャット導線（下部） -->
    <div class="max-w-5xl mx-auto px-4 pb-8 text-center">
      <a
        href="/chat"
        class="inline-block bg-blue-600 text-white font-semibold px-8 py-3 rounded-lg shadow hover:bg-blue-700 transition-colors"
      >
        AIに話しかける
      </a>
    </div>

  </body>
</html>
