---
import '../styles/global.css';
import AuthGuard from '../components/AuthGuard';
import StudentDashboard from '../components/StudentDashboard';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>学生ダッシュボード — 研究室ボット</title>
  </head>
  <body class="bg-gray-50 min-h-screen">

    <!-- ヘッダー -->
    <header class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
      <h1 class="text-xl font-bold text-gray-900">学生ダッシュボード</h1>
      <div class="flex items-center gap-4">
        <AuthGuard client:load />
        <a
          href="/chat"
          class="bg-blue-600 text-white font-semibold px-5 py-2 rounded-lg shadow hover:bg-blue-700 transition-colors text-sm"
        >
          相談する（チャットへ）
        </a>
      </div>
    </header>

    <StudentDashboard client:load />

  </body>
</html>
